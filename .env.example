# Copy this file to .env.local and fill in what you have. Both are optional —
# StoryLens runs fully on its own generated art and structured mock analysis
# with neither set.

# TMDB (themoviedb.org) v3 API key. When set, film posters/backdrops/runtime
# resolve from TMDB instead of StoryLens's own generated cover art.
VITE_TMDB_API_KEY=

# URL of a server-side route that accepts { text, scenes, characters } and
# returns StoryLens's AnalysisResult JSON (see src/services/aiService.ts).
# This is deliberately NOT a provider key read from the client — route real
# LLM calls through your own backend so the key never ships in the bundle.
VITE_AI_ENDPOINT=
